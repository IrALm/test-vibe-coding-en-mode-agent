# Copier ce fichier en ".env" (à côté de docker-compose.yml) et renseigner
# de vraies valeurs avant de lancer `docker compose up -d`. Ne jamais
# committer le fichier ".env" (voir .gitignore à la racine du repo).

# --- Consommées par docker-compose.yml ---

# Rôle superutilisateur du conteneur postgres de développement.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme

# Compte admin bootstrap du conteneur Keycloak (console d'administration).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Consommées directement par l'application Spring Boot (voir
# src/main/resources/application.yaml) ---

# Identifiants du rôle PostgreSQL "compta_admin", propriétaire de
# postgres_admin_db (créé via scripts/bootstrap_postgres.sql).
COMPTA_ADMIN_DB_USER=compta_admin
COMPTA_ADMIN_DB_PASSWORD=changeme

# Clé AES-256 encodée en base64 (32 octets une fois décodée), utilisée pour
# chiffrer les mots de passe de connexion aux bases tenant.
# Générer une clé de développement avec : openssl rand -base64 32
COMPTA_MASTER_KEY=changeme_base64_32_bytes_key

# URL de base du serveur Keycloak. Avec le docker-compose.yml fourni,
# Keycloak est exposé côté host sur le port 8081 (le port 8080 étant déjà
# occupé par l'application Spring Boot elle-même en développement local).
KEYCLOAK_BASE_URL=http://localhost:8081
